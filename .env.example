# Server-only Etherscan API key for the transaction history route (Etherscan
# API V2, https://etherscan.io/myapikey). Do not prefix it with NEXT_PUBLIC_;
# it must never reach browser code.
ETHERSCAN_API_KEY=

# Server-only HMAC secret for signing history pagination cursors. Generate with
# `openssl rand -hex 32`. Required in production; local development falls back
# to ETHERSCAN_API_KEY when unset. Never prefix with NEXT_PUBLIC_.
HISTORY_CURSOR_SECRET=

# Optional per-chain RPC overrides. Copy this file to .env and fill in any
# endpoint you want to use. When a value is unset, the app falls back to a
# public RPC for that chain, so the wallet works with zero configuration.
# NEXT_PUBLIC_RPC_URL_1=
# NEXT_PUBLIC_RPC_URL_8453=
# NEXT_PUBLIC_RPC_URL_42161=
# NEXT_PUBLIC_RPC_URL_10=
# NEXT_PUBLIC_RPC_URL_137=
# NEXT_PUBLIC_RPC_URL_11155111=
# NEXT_PUBLIC_RPC_URL_84532=
